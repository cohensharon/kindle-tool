# SMTP settings for sending EPUB attachments to Kindle.
# Copy to .env for local CLI use, or .env.local for Next.js.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Must be approved in your Amazon Kindle settings.
FROM_EMAIL=approved-sender@example.com

# Exposed to the browser so the UI can tell users which address to whitelist.
# Set to the same value as FROM_EMAIL.
NEXT_PUBLIC_FROM_EMAIL=approved-sender@example.com
